# Database (local dev uses Docker Postgres on host port 5433)
DATABASE_URL="postgresql://libirabu:libirabu_dev@localhost:5433/libirabu"

# NextAuth
NEXTAUTH_URL=http://localhost:8100
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# AES-256-GCM key for sensitive columns/files (32 bytes, base64)
# openssl rand -base64 32
ENCRYPTION_KEY=

# Local file store for attachments
FILE_STORE_PATH=./.data/files

# JHU gateway (AI assistant) — server-side only, never expose to the client
JHU_GATEWAY_URL=https://gateway.engineering.jhu.edu
JHU_GATEWAY_KEY=
